APP_NAME=Fortis
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# php artisan serve --no-reload ile birden fazla istek aynı anda işlenir (chat ve çalışma takibi SSE kullanır)
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Kestra — kimlik bilgileri sadece burada durur. React ve Claude Kestra'ya doğrudan erişmez.
KESTRA_URL=http://127.0.0.1:8080
KESTRA_USERNAME=
KESTRA_PASSWORD=
KESTRA_TENANT=main
KESTRA_VERSION=2.0.4
KESTRA_NAMESPACE=fortis.chat
# Kestra'da tanımlı secret isimleri (değerleri değil), virgülle ayrılmış
KESTRA_SECRETS=

# Kestra → Laravel iç uçları (/api/internal/*). Anahtar Kestra'ya FORTIS_INTERNAL_KEY secret'ı olarak da eklenir
# ve KESTRA_SECRETS listesine yazılır. Adres Kestra'nın Laravel'e ulaştığı adrestir (boşsa APP_URL).
FORTIS_INTERNAL_KEY=
FORTIS_INTERNAL_URL=

# Claude API — anahtar sadece burada durur, asla frontend'e veya Kestra'ya gitmez.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# IBS veri ambarı (MySQL). VPN üzerinden erişilir.
IBS_DB_HOST=
IBS_DB_PORT=3306
IBS_DB_DATABASE=
IBS_DB_USERNAME=
IBS_DB_PASSWORD=

# SAP SuccessFactors (İK) OData v2
SF_BASE_URL=
SF_USERNAME=
SF_PASSWORD=
SF_ALLOW_WRITES=false

# APM REST API (uçuş operasyonları). Spec: docs/integrations/apm-openapi.json
APM_BASE_URL=
# Kestra'nın tünel üzerinden gördüğü adres (ör. http://172.17.0.1:14070/test-restapi)
APM_KESTRA_BASE_URL=
APM_GRANT_TYPE=client_credentials
APM_CLIENT_ID=
APM_CLIENT_SECRET=
APM_USERNAME=
APM_PASSWORD=
APM_ALLOW_WRITES=false

# Sesli komut (infra/whisper)
VOICE_ENABLED=true
WHISPER_URL=http://127.0.0.1:9000

# Giriş: password (e-posta + şifre) | entra (Microsoft Entra ID)
AUTH_DRIVER=password
# İlk admin (php artisan db:seed). Şifre konsola yazılır, ilk girişte değiştirilir.
FORTIS_ADMIN_EMAIL=
# Arayüzün adresleri (Sanctum çerez oturumu bu adreslerden gelen isteklere açılır)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,[::1]:5173,localhost:8000,127.0.0.1:8000
# Canlıda (HTTPS) true
SESSION_SECURE_COOKIE=false
# Entra ID uygulama kaydı (AUTH_DRIVER=entra iken)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=
