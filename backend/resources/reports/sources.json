{
  "note": "Rapora eklenebilecek alanlar. TC kimlik, telefon, doğum tarihi gibi alanlar bilerek yok. aggregatable: Claude'a giden toplamlarda (sayım/toplam) kullanılabilir; kişi adı, sicil, uçuş no gibi satır düzeyi alanlar hiçbir zaman aggregatable olmaz.",
  "sources": [
    {
      "name": "apm_ucuslar",
      "title": "Uçuşlar (APM)",
      "system": "apm",
      "description": "Tarih aralığındaki planlı uçuş bacakları: uçuş no, kalkış/varış, planlanan saatler, uçak tipi, iptal ve rötar bilgisi. Tarih aralığı UTC gün sınırlarıdır.",
      "params": [
        {
          "name": "from",
          "label": "Başlangıç günü",
          "type": "date",
          "required": true
        },
        {
          "name": "to",
          "label": "Bitiş günü (hariç)",
          "type": "date",
          "required": true
        }
      ],
      "request": {
        "path": "/api/legs?dateFrom={from}T00:00:00Z&dateTo={to}T00:00:00Z",
        "rows": "legs.content",
        "page_param": "page",
        "total_pages": "totalNumberOfPages"
      },
      "fields": {
        "flight_no": {
          "label": "Uçuş No",
          "type": "string",
          "paths": [
            "flightNumberInfo.designator",
            "flightNumberInfo.flightNumber"
          ]
        },
        "dep_airport": {
          "label": "Kalkış",
          "type": "string",
          "path": "airportsInfo.scheduledDepartureAirportCode",
          "aggregatable": true
        },
        "arr_airport": {
          "label": "Varış",
          "type": "string",
          "path": "airportsInfo.scheduledArrivalAirportCode",
          "aggregatable": true
        },
        "std": {
          "label": "Planlanan Kalkış",
          "type": "datetime",
          "path": "flightTimes.scheduledTimeDeparture"
        },
        "sta": {
          "label": "Planlanan Varış",
          "type": "datetime",
          "path": "flightTimes.scheduledTimeArrival"
        },
        "atd": {
          "label": "Gerçekleşen Kalkış",
          "type": "datetime",
          "path": "flightTimes.actualTimeDeparture"
        },
        "aircraft_type": {
          "label": "Uçak Tipi",
          "type": "string",
          "path": "aircraftInfo.aircraftTypeCode",
          "aggregatable": true
        },
        "registration": {
          "label": "Tescil",
          "type": "string",
          "path": "aircraftInfo.actualAircraftRegistration"
        },
        "cancelled": {
          "label": "İptal",
          "type": "boolean",
          "path": "statusInfo.cancelled",
          "aggregatable": true
        },
        "delay_minutes": {
          "label": "Rötar (dk)",
          "type": "integer",
          "path": "delaysInfo.departureDelay1.delayDurationInMinutes",
          "aggregatable": true
        },
        "delay_code": {
          "label": "Rötar Kodu",
          "type": "string",
          "path": "delaysInfo.departureDelay1.delayCode",
          "aggregatable": true
        }
      }
    },
    {
